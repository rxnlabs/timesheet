{
	"name": "deyonte-basic",
	"version": "1.0.0",
	"private": true,
	"description": "Basic assets builder and transpiler for JS and CSS files. Compiles TypeScript and uses Eslint.",
	"engines": {
		"node": ">=16.x <=27.x",
		"npm": ">=8.x <=14.x"
	},
	"scripts": {
		"watch": "npm run styles -- --ext css --watch & npm run styles -- --ext min.css --env production --watch & npm run scripts -- --watch && kill $!",
		"dev": "NODE_ENV=development vite build --config vite.config.mjs",
		"build": "npm run react || npm run html",
		"styles": "postcss app/styles/*.scss app/styles/**/*.scss app/styles/*.css app/styles/**/*.css !app/styles/_*.scss !app/styles/**/_*.scss app/styles/_*.css !app/styles/**/_*.css --dir public/build/css --map --verbose",
		"scripts": "vite build --config vite.config.mjs",
		"lint": "npx eslint \"app/**/*.{js,jsx,ts,tsx,mjs,mjsx}\"",
		"lint:fix": "npx eslint \"app/**/*.{js,jsx,ts,tsx,mjs,mjsx}\" --fix",
		"ddev": "vite vite.ddev.config.mjs"
	},
	"author": "De'Yonté Wilkinson",
	"license": "GPL-3.0",
	"browserslist": {
		"development": [
			"last 1 Chrome version",
			"last 1 Firefox version",
			"last 1 Safari version"
		],
		"production": [
			"last 5 versions",
			"> 0.1%",
			"not dead"
		]
	},
	"devDependencies": {
		"@babel/preset-react": "^7.26.3",
		"@csstools/postcss-sass": "^5.1.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/postcss": "^4.0.17",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.0.17",
		"@types/react": "^19.0.12",
		"@types/react-dom": "^19.0.4",
		"@typescript-eslint/eslint-plugin": "^8.28.0",
		"@typescript-eslint/parser": "^8.28.0",
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.21",
		"cssnano": "^7.0.6",
		"eslint": "^9.23.0",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-react": "^7.37.4",
		"fast-glob": "^3.3.3",
		"globals": "^16.0.0",
		"path": "^0.12.7",
		"postcss": "^8.5.3",
		"postcss-cli": "^11.0.1",
		"postcss-import": "^16.1.0",
		"postcss-nested": "^7.0.2",
		"postcss-scss": "^4.0.9",
		"sass": "^1.86.0",
		"tailwindcss": "^4.0.17",
		"tslib": "^2.8.1",
		"typescript": "^5.8.2",
		"vite": "^6.2.3",
		"vite-plugin-filter-replace": "^0.1.14",
		"vite-plugin-watch-and-run": "^1.7.4",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"dependencies": {
		"@reduxjs/toolkit": "^2.6.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-redux": "^9.2.0",
		"react-router": "^7.4.0"
	}
}
